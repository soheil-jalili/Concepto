# ======================
# Frontend (Next.js / Node)
# ======================
/frontend/node_modules/
/frontend/.next/
/frontend/out/
/frontend/build/
# Yarn / pnpm
/frontend/.pnp
/frontend/.pnp.*
/frontend/.yarn/*
!/frontend/.yarn/patches
!/frontend/.yarn/plugins
!/frontend/.yarn/releases
!/frontend/.yarn/versions
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/.pnpm-debug.log*

# Frontend env
/frontend/.env*
/frontend/next-env.d.ts

# Misc
.DS_Store
*.pem

# Vercel
.vercel

# TypeScript build info
*.tsbuildinfo

# ======================
# Backend (Django / Python)
# ======================
/backend/__pycache__/
/backend/**/*.pyc
/backend/**/*.pyo
/backend/**/*.pyd
/backend/db.sqlite3
/backend/media/
/backend/staticfiles/

# Django secret keys / env
/backend/*.env
/backend/*.env.local
/backend/*.env.*.local

# Django migrations
/backend/**/migrations/__pycache__/
/backend/**/migrations/*.py

# DRF / Cache
/backend/*.token
/backend/*.cache

# PostgreSQL
/backend/*.sql
/backend/*.psql
/backend/pgdata/
/backend/postgres-data/

# ======================
# Coverage / Testing
# ======================
/coverage/
